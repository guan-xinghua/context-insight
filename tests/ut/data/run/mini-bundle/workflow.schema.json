{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:workflow-bundle:v1",
  "title": "context.workflow-bundle v1",
  "description": "Opsbot/Insight 工作流关系清单（workflow.json）结构契约；随导出包分发，与数据同版本。根 = workflow + schema/version 信封；data.members 每项按 kind 是 process/session/workflow 之一。",
  "allOf": [
    { "$ref": "#/definitions/workflow" },
    {
      "required": ["schema", "version"],
      "properties": {
        "schema": { "const": "context.workflow-bundle" },
        "version": { "const": 1 }
      }
    }
  ],
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "instant": { "type": ["string", "null"] },

    "process": {
      "type": "object",
      "required": ["id", "kind", "name", "startedAt", "finishedAt"],
      "properties": {
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "kind": { "const": "process" },
        "name": { "type": ["string", "null"] },
        "startedAt": { "$ref": "#/definitions/instant" },
        "finishedAt": { "$ref": "#/definitions/instant" },
        "output": { "$ref": "#/definitions/output" },
        "annotation": { "$ref": "#/definitions/memberAnnotation" }
      },
      "additionalProperties": true
    },

    "session": {
      "type": "object",
      "required": ["id", "kind", "name", "sessionId", "location", "startedAt", "finishedAt"],
      "properties": {
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "kind": { "const": "session" },
        "name": { "type": ["string", "null"] },
        "startedAt": { "$ref": "#/definitions/instant" },
        "finishedAt": { "$ref": "#/definitions/instant" },
        "sessionId": { "type": ["string", "null"] },
        "location": { "type": ["string", "null"] },
        "annotation": { "$ref": "#/definitions/memberAnnotation" }
      },
      "additionalProperties": true
    },

    "workflow": {
      "type": "object",
      "required": ["id", "kind", "name", "startedAt", "finishedAt", "data"],
      "properties": {
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "kind": { "const": "workflow" },
        "name": { "$ref": "#/definitions/nonEmptyString" },
        "startedAt": { "$ref": "#/definitions/instant" },
        "finishedAt": { "$ref": "#/definitions/instant" },
        "annotation": { "$ref": "#/definitions/annotation" },
        "data": { "$ref": "#/definitions/workflowData" }
      },
      "additionalProperties": true
    },

    "member": {
      "oneOf": [
        { "$ref": "#/definitions/process" },
        { "$ref": "#/definitions/session" },
        { "$ref": "#/definitions/workflow" }
      ]
    },

    "workflowData": {
      "type": "object",
      "required": ["members", "relations"],
      "properties": {
        "exportDataComplete": { "type": "boolean" },
        "members": { "type": "array", "items": { "$ref": "#/definitions/member" } },
        "relations": { "type": "array", "items": { "$ref": "#/definitions/relation" } }
      },
      "additionalProperties": true
    },

    "output": {
      "type": "object",
      "properties": { "text": { "type": "string" } },
      "additionalProperties": false
    },

    "memberAnnotation": {
      "type": "object",
      "properties": {
        "note": { "type": "string" },
        "graph": { "$ref": "#/definitions/graphAnnotation" }
      },
      "additionalProperties": true
    },

    "annotation": {
      "type": "object",
      "properties": { "note": { "type": "string" } },
      "additionalProperties": true
    },

    "graphAnnotation": {
      "type": "object",
      "required": ["nodeId", "generation", "attempt", "role"],
      "properties": {
        "nodeId": { "$ref": "#/definitions/nonEmptyString" },
        "generation": { "type": "integer", "minimum": 0 },
        "attempt": { "type": "integer", "minimum": 0 },
        "role": { "enum": ["execute", "verify"] },
        "attemptResult": { "enum": ["succeeded", "failed"] },
        "verification": { "$ref": "#/definitions/verification" },
        "retryPolicy": { "$ref": "#/definitions/retryPolicy" },
        "runOnFailure": { "type": "boolean" },
        "executionState": { "enum": ["carried"] },
        "resultFromGeneration": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },

    "verification": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "status": { "enum": ["passed", "failed", "running"] },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    },

    "retryPolicy": {
      "type": "object",
      "properties": {
        "maxRetries": { "type": "integer", "minimum": 0 },
        "onExhaust": {
          "enum": ["continue", "rollback", "stop", "exit", "fail"],
          "description": "exit/fail 是历史值，与 stop 语义等价，导出侧已在归一阶段映射为 stop；此处收录仅用于兼容旧包（缺 schema 走内置权威回退时）校验，新导出不会再产出。"
        },
        "rollbackToNodeId": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },

    "relation": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/definitions/nonEmptyString" },
        "to": { "$ref": "#/definitions/nonEmptyString" },
        "annotation": { "$ref": "#/definitions/relationAnnotation" }
      },
      "additionalProperties": true
    },

    "relationAnnotation": {
      "type": "object",
      "properties": {
        "type": { "enum": ["depends_on", "rollback", "gen-sub-graph", "handoff"] },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}