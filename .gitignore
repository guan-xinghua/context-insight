# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
proxy/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# export-view bundle (构建产物，由 npm run build:export-view 生成，start.sh 自动构建)
/public/export-view.js

# misc
.DS_Store
*.pem

# claude code local settings (per-user, per-machine)
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# context window config (user-specific, repo root only — test fixtures with the same name stay tracked)
/context-windows.json

# workflow extract plugin config (deployment-specific; example committed)
workflow-extract-plugins.json

# prisma
prisma/dev.db
prisma/dev.db-journal
prisma/dev.db-wal
prisma/dev.db-shm
prisma/test.db
prisma/test.db-journal
prisma/test.db-wal
prisma/test.db-shm
/dev.db
/dev.db-journal
/dev.db-wal
/dev.db-shm

# test data (large files)
tests/ut/data/opencode-sessions.db
tests/ut/data/opencode-sessions.db-shm
tests/ut/data/opencode-sessions.db-wal
# e2e fixture db is rebuilt from opencode-sample.sql at test time (OAT: no binary)
tests/ut/data/e2e/opencode-sample.db
tests/ut/data/e2e/opencode-sample.db-shm
tests/ut/data/e2e/opencode-sample.db-wal

# favicon: use src/app/icon.svg (text) instead of binary .ico (OAT: no binary)
src/app/favicon.ico

# logs (large DB files, generated analysis JSON, and runtime symlink)
logs/
logs

# temp files (compressed trajectories, analysis outputs)
/tmp/
smart-agent/tmp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# package lock (regenerated by npm install, platform-specific)
package-lock.json

# export-db.mjs output
dbfile/
jsonlfile/
proxy/node_modules/
# proxy test fixtures (binary/base64 — not for the repo)
proxy/tests/data/codex-zstd-request.base64
proxy/tests/data/codex-zstd-request.json

# proxy test files depending on binary fixtures (not in repo)
proxy/tests/request-body-decoder.test.ts
proxy/tests/server-capture.integration.test.ts

# scoring v2 runtime data (scorecard cache + user-defined dimensions)
data/scorecards/
data/judge-logs/
data/scoring/

# vitest generated reports (junit/html)
test-report/

# CLI bundle (npm prepack artifact, esbuild → dist/cli.mjs)
dist/

# brand variant pack staging (pack-cannbot.mjs; keep out of npm artifacts)
.context-pack/
.cannbot-pack/
