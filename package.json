{
  "name": "cannbot-insight",
  "version": "0.2.27",
  "description": "Session-level observability tool for LLM coding agents (opencode/Claude Code)",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "cannbot-insight": "./bin/cannbot-insight.mjs",
    "cbi": "./bin/cannbot-insight.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:export-view": "node scripts/build-export-view.mjs",
    "start": "next start",
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "node scripts/build-cli.mjs",
    "lint": "eslint",
    "ensure:native": "node scripts/ensure-native.mjs",
    "pretest": "node scripts/ensure-native.mjs && node scripts/ensure-test-db.mjs",
    "pretest:watch": "node scripts/ensure-native.mjs && node scripts/ensure-test-db.mjs",
    "pretest:cli": "node scripts/ensure-native.mjs && node scripts/ensure-test-db.mjs",
    "pretest:bench": "node scripts/ensure-native.mjs && node scripts/ensure-test-db.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli/index.ts",
    "test:cli": "vitest run tests/cli/",
    "test:bench": "vitest bench --run",
    "test:report": "vitest run --reporter=verbose --reporter=junit --outputFile=test-report/junit.xml",
    "test:report:html": "vitest run --reporter=html --outputFile=test-report/index.html",
    "test:report:serve": "vite preview --outDir test-report --port 21031 --host"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/client": "^6",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^11",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "cli-truncate": "^6.0.0",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "ink": "^7.0.6",
    "ink-testing-library": "^4.0.0",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "prisma": "^6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "string-width": "^8.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "happy-dom": "^20.10.6",
    "vitest": "^3"
  }
}
